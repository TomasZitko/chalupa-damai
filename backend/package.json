    "jose": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "@hono/zod-validator": "^0.4.1",
    "resend": "^4.0.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
