# Copy to .dev.vars for local development (wrangler reads this instead of .env)
# NEVER commit .dev.vars to git

FRONTEND_URL=https://yourdomain.cz
RESEND_API_KEY=
JWT_SECRET=
ADMIN_PASSWORD_HASH=

# Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your_password', 12))"
# or use:
#   npm run hash-password
